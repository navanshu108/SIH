{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/index.css", "src/vite-env.d.ts", "src/components/Layout.tsx", "src/pages/KisanPages.tsx", "src/data/cropsIndia.ts", "src/services/mockServices.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
